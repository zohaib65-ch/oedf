# Copy to .env and fill in the values below. Never commit .env.
# Nothing has a built-in default (see docs/setup-and-deployment.md). Every variable is validated at
# startup by src/env.ts, which names a bad variable but never prints its value.

# The site's address, used for links, metadata and the same-origin check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string: Atlas, Connect, Drivers (mongodb+srv://<user>:<password>@<cluster>/oedf).
# Add your IP address under Atlas, Network Access, or the connection is refused.
MONGODB_URI=

# Session signing secret, 32+ random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cloudinary folder all uploads go into. Required, one per environment so they never mix:
# oedf-dev on your machine, oedf-preview on preview deployments, oedf in production.
CLOUDINARY_FOLDER=oedf-dev

# Cloudinary connection for uploads: cloudinary://<api key>:<api secret>@<cloud name>.
# Cloudinary console: Settings, API Keys, "API environment variable" (copy it; reveal the secret first).
CLOUDINARY_URL=

# Outgoing mail. Locally this is Mailpit (`docker compose up -d`, inbox on http://localhost:8025);
# on a deployment, the mail provider's smtps://<user>:<password>@<host>:465.
SMTP_URL=smtp://localhost:1025
# The sender of every email.
EMAIL_FROM=OEDF <no-reply@localhost>

# Optional locally, required on a deployment (see docs/setup-and-deployment.md).
CRON_SECRET=
