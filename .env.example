# Copy to .env and fill in the four values below. Never commit .env.
# Everything else has a development default (see docs/setup-and-deployment.md). Every variable is
# validated at startup by src/env.ts, which names a bad variable but never prints its value.

# The site's address, used for links, metadata and the same-origin check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB connection string. It must point to a replica set so transactions work.
# Local (docker compose up -d): mongodb://localhost:27017/oedf?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/oedf?replicaSet=rs0

# Session signing secret, 32+ random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cloudinary connection for uploads: cloudinary://<api key>:<api secret>@<cloud name>.
# Cloudinary console: Settings, API Keys, "API environment variable" (copy it; reveal the secret first).
CLOUDINARY_URL=

