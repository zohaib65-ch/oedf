# Copy to .env.local and fill in the values. Never commit .env.local.
# Every variable is validated at startup by src/env.ts. See docs/setup-and-deployment.md.

# Canonical site URL, used for metadata and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB connection string. It must point to a replica set so transactions work.
# Local (docker compose up -d): mongodb://localhost:27017/oedf?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/oedf?replicaSet=rs0

# Session signing secret, 32+ random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Auth base URL, the same as the site URL.
BETTER_AUTH_URL=http://localhost:3000

# Optional. One of: fatal, error, warn, info, debug, trace, silent. Defaults to info.
LOG_LEVEL=info

# First Super Admin. Used only by `npm run db:seed`. The password needs 12+ characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
