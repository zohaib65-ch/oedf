{
  "name": "oedf-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "db:indexes": "tsx --env-file-if-exists=.env --conditions=react-server scripts/sync-indexes.ts",
    "db:seed": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed.ts",
    "db:reset-for-launch": "tsx --env-file-if-exists=.env scripts/reset-for-launch.ts",
    "db:seed:sample": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed-sample.ts",
    "check": "npm run lint && npm run typecheck && npm run knip",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,css,json,md,yaml,yml}": "prettier --write",
    "*.{ts,tsx,mjs}": "eslint --fix"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.27",
    "@hookform/resolvers": "^7.0.9",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.79.0",
    "mongodb": "^7.9.1",
    "mongoose": "^9.12.3",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.16",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.9"
    }
  }
}
